# ShePeak configuration. Copy to .env and fill in. Never commit a real .env.

# --- Database -----------------------------------------------------------------------
# The application connects as a NON-OWNER role holding neither SUPERUSER nor BYPASSRLS.
# Connecting as the owner silently defeats every RLS policy (ADR-0001 condition 2).
SHEPEAK_DSN=postgresql://shepeak_app:CHANGE_ME@localhost:55432/shepeak

# Owner connection — migrations and tests ONLY. Never used to serve a request.
SHEPEAK_OWNER_DSN=postgresql://shepeak_owner:CHANGE_ME@localhost:55432/shepeak

# --- Auth ---------------------------------------------------------------------------
SHEPEAK_JWT_SECRET=CHANGE_ME_LONG_RANDOM_VALUE

# --- Explanation narrative (optional) -------------------------------------------------
# The LLM may ONLY rephrase an already-computed explanation (FR-002). It cannot set or
# change any score, threshold, band, or prescription, and the narrative is re-checked
# against the deterministic verdict before it is returned (FR-003).
#
# Leave UNSET to ship deterministic explanations only. The product is fully functional
# that way — the narrative is a courtesy on top of the guarantee, not part of it.
#
# If you enable it, you MUST pin an exact model id: FR-008 requires the model version in
# every audit entry, so a floating alias is not a valid configuration.
#   Recommended: claude-sonnet-5
# SHEPEAK_LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=...
